{
  "info": {
    "name": "Patient Management System API (Phase 1 & Phase 2)",
    "description": "Postman Collection for testing Phase 1 REST API and Phase 2 AI follow-up draft workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Standard Operations (Patients)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Create Patient (Standard)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anita Rao\",\n  \"phone\": \"98765 43210\",\n  \"consultationDate\": \"2026-11-01\",\n  \"followUpDate\": \"2026-11-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        },
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Get Due Today Patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/due-today?includeOverdue=true",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "due-today"],
              "query": [
                {
                  "key": "includeOverdue",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Complete Follow-up",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/1/complete",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "1", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "2. AI Drafts Workflow (Phase 2)",
      "item": [
        {
          "name": "Generate Drafts (Due Today)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"includeOverdue\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/generate",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "generate"]
            }
          }
        },
        {
          "name": "Generate Drafts (Include Overdue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"includeOverdue\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/generate",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "generate"]
            }
          }
        },
        {
          "name": "Get All Drafts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drafts",
              "host": ["{{baseUrl}}"],
              "path": ["drafts"]
            }
          }
        },
        {
          "name": "Get Pending Review Drafts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drafts?status=pending_review",
              "host": ["{{baseUrl}}"],
              "path": ["drafts"],
              "query": [
                {
                  "key": "status",
                  "value": "pending_review"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Draft",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drafts/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "1", "approve"]
            }
          }
        },
        {
          "name": "Approve Draft (Edited Message)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello Aarav, this is a reminder about your follow-up visit on 2026-11-10. Please reply to let us know if morning works for you. Take care!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "1", "approve"]
            }
          }
        },
        {
          "name": "Reject Draft",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drafts/2/reject",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "2", "reject"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Validation & Security Errors (Bad Input)",
      "item": [
        {
          "name": "Bad Type - Numeric Phone (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anita Rao\",\n  \"phone\": 9876543210,\n  \"consultationDate\": \"2026-11-01\",\n  \"followUpDate\": \"2026-11-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        },
        {
          "name": "Generate - Non-boolean includeOverdue (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"includeOverdue\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/generate",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "generate"]
            }
          }
        },
        {
          "name": "Approve - Message Under 100 Chars (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Too short\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "1", "approve"]
            }
          }
        },
        {
          "name": "Approve - Message Without Letters (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"1234567890 1234567890 1234567890 1234567890 1234567890 1234567890 1234567890 1234567890 1234567890 1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "1", "approve"]
            }
          }
        },
        {
          "name": "Approve - Empty Message (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"   \"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drafts/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "1", "approve"]
            }
          }
        },
        {
          "name": "Approve - Bad Path ID (400)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drafts/007/approve",
              "host": ["{{baseUrl}}"],
              "path": ["drafts", "007", "approve"]
            }
          }
        },
        {
          "name": "Get Drafts - Unknown Status (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drafts?status=invalid_status",
              "host": ["{{baseUrl}}"],
              "path": ["drafts"],
              "query": [
                {
                  "key": "status",
                  "value": "invalid_status"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
